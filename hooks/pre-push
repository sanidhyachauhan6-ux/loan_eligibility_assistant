#!/bin/sh
# pre-push hook — the local equivalent of a CI merge gate.
# git runs this BEFORE sending commits to the remote; non-zero exit blocks the push.
echo ""
echo ">>> pre-push hook: running the eval gate before allowing this push <<<"
echo ""
./scripts/eval-gate.sh
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo ">>> PUSH BLOCKED: eval gate failed. Fix the regression and try again. <<<"
  exit $status
fi
echo ""
echo ">>> Eval gate passed — push allowed. <<<"
exit 0
